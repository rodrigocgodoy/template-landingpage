{
  "name": "template-landingpage",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready landing page template: React 19, TanStack Start (static prerendering), Tailwind CSS v4, shadcn/ui and Biome — with SEO, AEO and accessibility baked in.",
  "keywords": [
    "landing-page",
    "template",
    "react",
    "tanstack-start",
    "tanstack-router",
    "vite",
    "tailwindcss",
    "shadcn-ui",
    "seo",
    "aeo"
  ],
  "author": "Rodrigo Godoy <rodrigo@dellub.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigocgodoy/template-landingpage.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
